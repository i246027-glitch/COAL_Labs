module control_unit32bit(
    input  [31:0] i_inst,
    input         i_br_eq,
    input         i_br_lt,

    output reg        PCSel,
    output reg [2:0]  ImmSel,
    output reg        RegWEn,
    output reg        BrUn,
    output reg        BSel,
    output reg        ASel,
    output reg [3:0]  ALUSel,
    output reg        MemRW,
    output reg [1:0]  WBSel
);

    wire [6:0] opcode;
    wire [2:0] funct3;
    wire       funct7_5;

    assign opcode   = i_inst[6:0];
    assign funct3   = i_inst[14:12];
    assign funct7_5 = i_inst[30];

    
    parameter R_TYPE  = 7'b0110011;
    parameter I_ALU   = 7'b0010011;
    parameter LOAD    = 7'b0000011;
    parameter STORE   = 7'b0100011;
    parameter BRANCH  = 7'b1100011;
    parameter JAL     = 7'b1101111;
    parameter JALR    = 7'b1100111;
    parameter LUI     = 7'b0110311; 
    parameter AUIPC   = 7'b0010111;

    
    parameter ALU_ADD  = 4'b0000;
    parameter ALU_SUB  = 4'b0001;
    parameter ALU_AND  = 4'b0010;
    parameter ALU_OR   = 4'b0011;
    parameter ALU_XOR  = 4'b0100;
    parameter ALU_SLL  = 4'b0101;
    parameter ALU_SRL  = 4'b0110;
    parameter ALU_SRA  = 4'b0111;
    parameter ALU_SLT  = 4'b1000;
    parameter ALU_SLTU = 4'b1001;
    parameter ALU_BSEL = 4'b1010;

    reg take_branch;

    always @(*) begin
      
        PCSel     = 1'b0;
        ImmSel    = 3'b000;
        RegWEn    = 1'b0;
        BrUn      = 1'b0;
        BSel      = 1'b0;
        ASel      = 1'b0;
        ALUSel    = ALU_ADD;
        MemRW     = 1'b0;
        WBSel     = 2'b01; 
        take_branch = 1'b0;

      
        casex (funct3)
            3'b000: take_branch = i_br_eq;          // beq
            3'b001: take_branch = ~i_br_eq;         // bne
            3'b100, 3'b110: take_branch = i_br_lt;  // blt, bltu
            3'b101, 3'b111: take_branch = ~i_br_lt; // bge, bgeu
            default: take_branch = 1'b0;
        endcase

        // Unsigned check for bltu / bgeu
        if (funct3 == 3'b110 || funct3 == 3'b111)
            BrUn = 1'b1;
        else
            BrUn = 1'b0;

        
        case (opcode)
            7'b0110011: begin // R-type
                RegWEn = 1'b1;
                BSel   = 1'b0; // Reg[rs2]
                ASel   = 1'b0; // Reg[rs1]
                WBSel  = 2'b01; // ALU result
                
                case (funct3)
                    3'b000: ALUSel = funct7_5 ? ALU_SUB : ALU_ADD;
                    3'b001: ALUSel = ALU_SLL;
                    3'b010: ALUSel = ALU_SLT;
                    3'b011: ALUSel = ALU_SLTU;
                    3'b100: ALUSel = ALU_XOR;
                    3'b101: ALUSel = funct7_5 ? ALU_SRA : ALU_SRL;
                    3'b110: ALUSel = ALU_OR;
                    3'b111: ALUSel = ALU_AND;
                    default: ALUSel = ALU_ADD;
                endcase
            end

            7'b0010011: begin // I-type ALU
                RegWEn = 1'b1;
                ImmSel = 3'b000;
                BSel   = 1'b1;   // Immediate
                ASel   = 1'b0;   // Reg[rs1]
                WBSel  = 2'b01;  // ALU result

                case (funct3)
                    3'b000: ALUSel = ALU_ADD;  // addi
                    3'b010: ALUSel = ALU_SLT;  // slti
                    3'b011: ALUSel = ALU_SLTU; // sltiu
                    3'b100: ALUSel = ALU_XOR;  // xori
                    3'b110: ALUSel = ALU_OR;   // ori
                    3'b111: ALUSel = ALU_AND;  // andi
                    3'b001: ALUSel = ALU_SLL;  // slli
                    3'b101: ALUSel = funct7_5 ? ALU_SRA : ALU_SRL; // srli/srai
                    default: ALUSel = ALU_ADD;
                endcase
            end

            7'b0000011: begin // Load (lw)
                RegWEn = 1'b1;
                ImmSel = 3'b000;
                BSel   = 1'b1;
                ASel   = 1'b0;
                ALUSel = ALU_ADD;
                MemRW  = 1'b0;   // Read memory
                WBSel  = 2'b00;  // Memory data to register
            end

            7'b0100011: begin // Store (sw)
                RegWEn = 1'b0;
                ImmSel = 3'b001; // S-type immediate
                BSel   = 1'b1;
                ASel   = 1'b0;
                ALUSel = ALU_ADD;
                MemRW  = 1'b1;   // Write memory
            end

            7'b1100011: begin // Branch
                RegWEn = 1'b0;
                ImmSel = 3'b010; // B-type immediate
                ASel   = 1'b1;   // PC
                BSel   = 1'b1;   // Immediate
                ALUSel = ALU_ADD;
                PCSel  = take_branch;
            end

            7'b1101111: begin // JAL
                RegWEn = 1'b1;
                ImmSel = 3'b011; // J-type immediate
                ASel   = 1'b1;   // PC
                BSel   = 1'b1;   // Immediate
                ALUSel = ALU_ADD;
                PCSel  = 1'b1;
                WBSel  = 2'b10;  // PC + 4
            end

            7'b1100111: begin // JALR
                RegWEn = 1'b1;
                ImmSel = 3'b000; // I-type immediate
                ASel   = 1'b0;   // Reg[rs1]
                BSel   = 1'b1;   // Immediate
                ALUSel = ALU_ADD;
                PCSel  = 1'b1;
                WBSel  = 2'b10;  // PC + 4
            end

            7'b0110111: begin // LUI
                RegWEn = 1'b1;
                ImmSel = 3'b011; // U-type immediate
                ALUSel = ALU_BSEL; // Pass immediate through ALU
                WBSel  = 2'b01;
            end

            7'b0010111: begin // AUIPC
                RegWEn = 1'b1;
                ImmSel = 3'b011; // U-type immediate
                ASel   = 1'b1;   // PC
                BSel   = 1'b1;   // Immediate
                ALUSel = ALU_ADD;
                WBSel  = 2'b01;
            end

            default: begin
                PCSel  = 1'b0;
                RegWEn = 1'b0;
            end
        endcase
    end

endmodule


module control_unit32bit_tb();

    reg [31:0] i_inst;
    reg        i_br_eq;
    reg        i_br_lt;

    wire       PCSel;
    wire [2:0] ImmSel;
    wire       RegWEn;
    wire       BrUn;
    wire       BSel;
    wire       ASel;
    wire [3:0] ALUSel;
    wire       MemRW;
    wire [1:0] WBSel;

 
    control_unit32bit uut (
        .i_inst(i_inst),
        .i_br_eq(i_br_eq),
        .i_br_lt(i_br_lt),
        .PCSel(PCSel),
        .ImmSel(ImmSel),
        .RegWEn(RegWEn),
        .BrUn(BrUn),
        .BSel(BSel),
        .ASel(ASel),
        .ALUSel(ALUSel),
        .MemRW(MemRW),
        .WBSel(WBSel)
    );

    initial begin
        i_br_eq = 0;
        i_br_lt = 0;

        // ADD 
        i_inst = 32'h00208133; 
        #20;

        //ADDI 
        i_inst = 32'h00510093; 
        #20;

        //  LW 
        i_inst = 32'h00012103; 
        #20;

        //  SW 
        i_inst = 32'h00208223; 
        #20;

        //  BEQ 
        i_br_eq = 1;
        i_inst = 32'h00208463; 
        #20;

        
    end

   
endmodule
